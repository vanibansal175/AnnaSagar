# ==============================================================================
# AnnaSagar Server Environment Variables (Canonical Reference)
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/annasagar?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Seeding (Used by npm run seed:admin)
ADMIN_EMAIL=admin@annasagar.org
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_chars

# Food Safety Time Rules (D6 Invariants, in minutes)
# Invariants enforced on startup:
# 1. MIN_LISTING_DURATION_MINUTES < MAX_LISTING_DURATION_MINUTES
# 2. WARNING_MINUTES < MIN_LISTING_DURATION_MINUTES
# 3. MAX_FOOD_AGE_AT_PICKUP_MINUTES > MAX_LISTING_DURATION_MINUTES
MAX_LISTING_DURATION_MINUTES=180
MIN_LISTING_DURATION_MINUTES=45
MAX_FOOD_AGE_AT_PICKUP_MINUTES=240
WARNING_MINUTES=30
